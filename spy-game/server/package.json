{
  "name": "spy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "docker compose up -d --wait && node dist/server.js",
    "dev": "docker compose up -d --wait && tsx watch src/server.ts",
    "lint": "eslint",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "install": "^0.13.0",
    "nodemon": "^3.1.14",
    "npm": "^11.21.2",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
